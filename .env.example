IACPAAS_BACKEND=mock
IACPAAS_BASE_URL=https://iacpaas.dvo.ru
IACPAAS_API_KEY=
IACPAAS_JWT=
IACPAAS_KNOWN_IRS=["Учебные/База наблюдений"]
IACPAAS_ALLOW_WRITE=false
MCP_BEARER_TOKEN=
OLLAMA_URL=http://127.0.0.1:11435
OLLAMA_MODEL=qwen-agent
OLLAMA_CONTEXT_LENGTH=32768
AGENT_CONTEXT_BUDGET=24000
OLLAMA_NUM_PREDICT=2048
AGENT_CONTEXT_LENGTH=32768
AGENT_KEEP_ALIVE=-1
AGENT_UNLOAD_AFTER_REQUEST=false
AGENT_MAX_STEPS=12
# Stop repeated reads/errors without new data independently of the total step budget (1..5).
AGENT_MAX_STAGNANT=3
# Per local model request timeout in seconds (1..600); max steps accepts 1..60.
AGENT_MODEL_TIMEOUT=180
AGENT_GPU_LAYERS=
# Defaults for the model picker; saved UI choices take precedence over LLM_PROVIDER.
LLM_PROVIDER=ollama
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Server-side write scope. Only your own folders outside Загрузки. Off by default.
IACPAAS_WRITE_ROOTS=["АТЛАС мои ресурсы"]
IACPAAS_CONFIRM_TIMEOUT=120
# Container uses persistent /data; native defaults keep existing .local and logs.
# IACPAAS_DATA_DIR=
# IACPAAS_LOG_DIR=
# OLLAMA_URL is the fallback; a URL saved in the model picker takes precedence.
# Docker is the primary deployment. Ollama runs separately on your PC or another server.
ATLAS_USERNAME=atlas
ATLAS_PASSWORD=
# Add your Proxmox VM/container IP or DNS name, without http:// or port.
# These are SITE/Host header addresses, NOT visitor IPs. Clients need network access + the password.
ATLAS_ALLOWED_HOSTS=["localhost","127.0.0.1"]
ATLAS_BIND_IP=0.0.0.0
# Reverse proxy/TLS is recommended outside a trusted LAN or VPN.
# VERIFIER_MODEL=optional-alternative-model-id
